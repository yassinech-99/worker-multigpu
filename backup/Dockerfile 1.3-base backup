# start from a clean base image (replace <version> with the desired release)
FROM runpod/worker-comfyui:5.4.1-base-cuda12.8.1 AS base

# Install system dependencies required for dlib and other packages
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libgtk-3-dev \
    libboost-python-dev \
    libopencv-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# install custom nodes using comfy-cli
# basic utility nodes
RUN comfy-node-install comfyui-kjnodes && \
    comfy-node-install rgthree-comfy && \
    comfy-node-install comfyui-easy-use
RUN comfy-node-install comfyui_essentials && \
    comfy-node-install comfyui-custom-scripts && \
    comfy-node-install comfyui-impact-pack && \
    comfy-node-install comfyui-impact-subpack
RUN comfy-node-install cg-use-everywhere && \
    comfy-node-install comfyui_layerstyle && \
    comfy-node-install comfyui-logicutils
# Install ComfyUI-Logic manually since it's archived and not available via comfy-node-install
RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/theUpsider/ComfyUI-Logic.git
RUN comfy-node-install bjornulf_custom_nodes && \
    comfy-node-install was-node-suite-comfyui

# image processing nodes
RUN comfy-node-install comfyui_controlnet_aux && \
    comfy-node-install comfyui-advanced-controlnet
RUN comfy-node-install comfyui-inpaint-cropandstitch && \
    comfy-node-install comfyui-rmbg
# Install face analysis node with dlib dependency
RUN comfy-node-install comfyui_faceanalysis || \
    (echo "Face analysis installation failed, trying alternative approach..." && \
     cd /comfyui/custom_nodes && \
     git clone https://github.com/cubiq/ComfyUI_FaceAnalysis.git && \
     /opt/venv/bin/python -m pip install dlib opencv-python)
# Install AutoCropFaces node manually
RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/liusida/ComfyUI-AutoCropFaces.git
RUN comfy-node-install comfyui_patches_ll

# video processing nodes
RUN comfy-node-install comfyui-videohelpersuite && \
    comfy-node-install comfyui-florence2 && \
    comfy-node-install ComfyUI-WanVideoWrapper
# Install TeaCache manually since it's not available via comfy-node-install
RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/welltop-cn/ComfyUI-TeaCache.git && \
    cd ComfyUI-TeaCache && \
    /opt/venv/bin/python -m pip install -r requirements.txt



# Install comfy-easy-grids custom node
RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/shockz0rz/comfy-easy-grids.git


# Download SegFormer B2 Clothes model for LayerMask node -- ComfyUI_LayerStyle custom node
RUN mkdir -p /comfyui/models/segformer_b2_clothes && \
    wget -P /comfyui/models/segformer_b2_clothes https://huggingface.co/mattmdjaga/segformer_b2_clothes/resolve/main/preprocessor_config.json && \
    wget -P /comfyui/models/segformer_b2_clothes https://huggingface.co/mattmdjaga/segformer_b2_clothes/resolve/main/pytorch_model.bin && \
    wget -P /comfyui/models/segformer_b2_clothes https://huggingface.co/mattmdjaga/segformer_b2_clothes/resolve/main/config.json

# Download Flux Redux model
RUN --mount=type=secret,id=hf_token \
    if [ -f /run/secrets/hf_token ]; then \
        export HUGGINGFACE_TOKEN=$(cat /run/secrets/hf_token) && \
        mkdir -p /comfyui/models/style_models && \
        wget --header="Authorization: Bearer $HUGGINGFACE_TOKEN" \
        -P /comfyui/models/style_models \
        https://huggingface.co/black-forest-labs/FLUX.1-Redux-dev/resolve/main/flux1-redux-dev.safetensors; \
    else \
        echo "WARNING: hf_token secret not found, skipping flux1-redux-dev download"; \
        mkdir -p /comfyui/models/style_models; \
    fi



# final image
FROM base AS final
# Copy local static input files into the ComfyUI input directory (delete if not needed)
# Assumes you have an 'input' folder next to your Dockerfile
# COPY input/ /comfyui/input/